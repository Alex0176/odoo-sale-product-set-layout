<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.product.set.layout</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="hide_in_report" optional="show" invisible="display_type != 'product'" />
            </xpath>
        </field>
    </record>
</odoo>
