<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.product.set.layout</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="hide_in_report" optional="show" invisible="display_type != 'product'" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/control/button[@name='action_add_from_catalog']" position="before">
                <button
                    class="px-2 btn-link"
                    type="action"
                    name="%(act_open_wizard_product_set_add_from_move)d"
                    groups="account.group_account_invoice"
                    string="Add set"
                    context="{'move_id': parent.id}"
                    invisible="parent.state != 'draft' or parent.move_type not in ('out_invoice', 'out_refund')"
                />
            </xpath>
        </field>
    </record>
</odoo>
